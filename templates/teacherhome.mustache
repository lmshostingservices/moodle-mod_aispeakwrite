{{!
    @template mod_aispeakwrite/teacherhome

    Teacher overview of the activity.

    Example context (json):
    {
        "cmid": 3, "taskcount": 5, "writingcount": 3, "speakingcount": 2, "learners": 14, "canmanage": true,
        "canreport": true, "manageurl": "#", "analyticsurl": "#", "settingsurl": "#", "notasks": false,
        "credentialsmissing": false, "hasbalance": true, "balance": "4,820", "lowcredits": false, "usedmonth": 312,
        "markings": 212, "partnerturns": 90
    }
}}
<div class="asw">
    {{> mod_aispeakwrite/teachernav }}
    <div>
        <h2 class="asw-h1">{{#str}}overview, mod_aispeakwrite{{/str}}</h2>
        <p class="asw-sub">{{#str}}overview_sub, mod_aispeakwrite{{/str}}</p>
    </div>
    {{#credentialsmissing}}<div class="asw-banner asw-banner--warn">{{#str}}credentialsmissingteacher, mod_aispeakwrite{{/str}}</div>{{/credentialsmissing}}
    {{#notasks}}<div class="asw-banner asw-banner--info">{{#str}}notasksteacher, mod_aispeakwrite{{/str}}</div>{{/notasks}}
    <div class="asw-grid">
        <section class="asw-card">
            <span class="asw-label">{{#str}}tasks, mod_aispeakwrite{{/str}}</span>
            <span class="asw-kpi asw-num">{{taskcount}}</span>
            <span class="asw-sub">{{#str}}taskcounts, mod_aispeakwrite, { "writing": {{writingcount}}, "speaking": {{speakingcount}} } {{/str}}</span>
            {{#canmanage}}<a class="asw-btn asw-btn--ink" href="{{manageurl}}">{{#str}}managetasks, mod_aispeakwrite{{/str}}</a>{{/canmanage}}
        </section>
        <section class="asw-card">
            <span class="asw-label">{{#str}}learnerspractising, mod_aispeakwrite{{/str}}</span>
            <span class="asw-kpi asw-num">{{learners}}</span>
            {{#canreport}}<a class="asw-btn asw-btn--soft" href="{{analyticsurl}}">{{#str}}analytics, mod_aispeakwrite{{/str}}</a>{{/canreport}}
        </section>
        <section class="asw-card">
            <span class="asw-label">{{#str}}feedbacksettings, mod_aispeakwrite{{/str}}</span>
            <span class="asw-sub">{{#str}}settingshint, mod_aispeakwrite{{/str}}</span>
            {{#canmanage}}<a class="asw-btn asw-btn--line" href="{{settingsurl}}">{{#str}}editsettings{{/str}}</a>{{/canmanage}}
        </section>
    </div>
    {{> mod_aispeakwrite/usage }}
</div>
