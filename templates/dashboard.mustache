{{!
    @template mod_aispeakwrite/dashboard

    Learner dashboard.

    Example context (json):
    {
        "cmid": 3,
        "greeting": "Good morning, Justus",
        "examline": "telc B1 in 6 weeks.",
        "markingsleft": "2 of 3 markings left today",
        "hasreadiness": true,
        "readiness": "62%",
        "readinessdash": "210.4 339.3",
        "readinesstag": "On track",
        "readinessgood": true,
        "readinesstext": "Based on 3 tasks",
        "continue": {"title": "Geburtstagsfeier", "meta": "Draft 1 marked", "tag": "Rewrite waiting",
            "hints": "4 hints to work on", "url": "#", "button": "Continue rewriting"},
        "next": {"title": "Abschiedsfeier", "meta": "Speaking · Part 3", "speaking": true, "url": "#", "button": "Start"},
        "hasskills": true,
        "skills": [{"label": "Writing", "rows": [{"label": "Content", "pct": 80, "good": true, "tag": "On track"}]}],
        "selfcorrections": "7 self-corrections this month",
        "hasfocus": true,
        "focus": [{"label": "Satzanfang", "type": "School tip", "line": "2 of last 5 right",
            "recentpct": 40}],
        "hasresults": true,
        "results": [{"title": "Geburtstagsfeier", "meta": "Email · 26/10/26 · Draft 1", "speaking": false,
            "score": "27 / 45 (telc 33)", "pillclass": "warn", "url": "#"}],
        "practiceurl": "#"
    }
}}
<div class="asw" id="asw-dashboard">
    {{> mod_aispeakwrite/nav }}
    <div class="asw-row asw-row--between">
        <div>
            <h2 class="asw-h1">{{greeting}}</h2>
            {{#examline}}<p class="asw-sub">{{examline}}</p>{{/examline}}
        </div>
        {{#markingsleft}}<span class="asw-pill asw-pill--line">{{markingsleft}}</span>{{/markingsleft}}
    </div>

    {{#notasks}}
        <div class="asw-banner asw-banner--info">{{#str}}notasksyet, mod_aispeakwrite{{/str}}</div>
    {{/notasks}}

    <div class="asw-grid">
        <section class="asw-card" aria-labelledby="asw-readiness-h">
            <h3 class="asw-label" id="asw-readiness-h">{{#str}}readiness, mod_aispeakwrite{{/str}}</h3>
            <div style="display: flex; gap: 22px; align-items: center;">
                <svg class="asw-ring" width="132" height="132" viewBox="0 0 132 132" role="img" aria-label="{{#str}}readiness, mod_aispeakwrite{{/str}} {{readiness}}">
                    <circle class="asw-ring__track" cx="66" cy="66" r="54" fill="none" stroke-width="12"></circle>
                    <circle class="asw-ring__value {{^readinessgood}}asw-ring__value--warn{{/readinessgood}}" cx="66" cy="66" r="54" fill="none" stroke-width="12" stroke-linecap="round" stroke-dasharray="{{readinessdash}}" transform="rotate(-90 66 66)"></circle>
                    <text x="66" y="74" text-anchor="middle" font-size="28" font-weight="650">{{readiness}}</text>
                </svg>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    {{#hasreadiness}}
                        <span class="asw-pill {{#readinessgood}}asw-pill--good{{/readinessgood}}{{^readinessgood}}asw-pill--warn{{/readinessgood}}">{{readinesstag}}</span>
                        <span class="asw-sub">{{readinesstext}}</span>
                    {{/hasreadiness}}
                    {{^hasreadiness}}<span class="asw-sub">{{#str}}readinessempty, mod_aispeakwrite{{/str}}</span>{{/hasreadiness}}
                </div>
            </div>
        </section>

        {{#continue}}
        <section class="asw-card">
            <div class="asw-row asw-row--between" style="align-items: center;">
                <h3 class="asw-label">{{#str}}continue, mod_aispeakwrite{{/str}}</h3>
                <span class="asw-pill asw-pill--warn">{{tag}}</span>
            </div>
            <div>
                <div style="font-size: 1.125rem; font-weight: 600;">{{title}}</div>
                <div class="asw-sub">{{meta}}</div>
            </div>
            {{#hints}}<span class="asw-pill asw-pill--bad">{{hints}}</span>{{/hints}}
            <a class="asw-btn asw-btn--ink" href="{{url}}">{{button}}</a>
        </section>
        {{/continue}}

        {{#next}}
        <section class="asw-card">
            <h3 class="asw-label">{{#str}}recommendednext, mod_aispeakwrite{{/str}}</h3>
            <div style="display: flex; gap: 14px; align-items: flex-start;">
                <span class="asw-tile {{#speaking}}asw-tile--speaking{{/speaking}}" aria-hidden="true">
                    {{#speaking}}<svg class="asw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>{{/speaking}}
                    {{^speaking}}<svg class="asw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>{{/speaking}}
                </span>
                <div>
                    <div style="font-size: 1.125rem; font-weight: 600;">{{title}}</div>
                    <div class="asw-sub">{{meta}}</div>
                </div>
            </div>
            <a class="asw-btn asw-btn--soft" href="{{url}}">{{button}}</a>
        </section>
        {{/next}}
    </div>

    <div class="asw-grid">
        <section class="asw-card">
            <h3 class="asw-h2">{{#str}}skillmastery, mod_aispeakwrite{{/str}}</h3>
            {{^hasskills}}<p class="asw-sub">{{#str}}skillsempty, mod_aispeakwrite{{/str}}</p>{{/hasskills}}
            {{#skills}}
                <span class="asw-label">{{label}}</span>
                {{#rows}}
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="display: flex; justify-content: space-between; gap: 10px;">
                            <span>{{label}}</span>
                            <span style="display: flex; gap: 10px; align-items: center;">
                                <span class="asw-pill {{#good}}asw-pill--good{{/good}}{{^good}}asw-pill--warn{{/good}}">{{tag}}</span>
                                <strong class="asw-num">{{pct}}%</strong>
                            </span>
                        </div>
                        <div class="asw-bar {{^good}}asw-bar--warn{{/good}}"><span style="width: {{pct}}%;"></span></div>
                    </div>
                {{/rows}}
            {{/skills}}
            {{#selfcorrections}}
                <div class="asw-banner asw-banner--good">
                    <svg class="asw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    <span>{{selfcorrections}}</span>
                </div>
            {{/selfcorrections}}
        </section>

        <section class="asw-card">
            <div class="asw-row asw-row--between" style="align-items: baseline;">
                <h3 class="asw-h2">{{#str}}focusareas, mod_aispeakwrite{{/str}}</h3>
                <span class="asw-sub">{{#str}}focusareas_sub, mod_aispeakwrite{{/str}}</span>
            </div>
            {{^hasfocus}}<p class="asw-sub">{{#str}}focusempty, mod_aispeakwrite{{/str}}</p>{{/hasfocus}}
            {{#focus}}
                <div class="asw-focus">
                    <span class="asw-progress" aria-hidden="true"><span style="width: {{recentpct}}%;"></span></span>
                    <span style="display: flex; flex-direction: column; flex: 1; min-width: 0;">
                        <strong>{{label}}</strong>
                        <span class="asw-sub">{{type}}</span>
                    </span>
                    <span class="asw-sub">{{line}}</span>
                </div>
            {{/focus}}
            <a class="asw-btn asw-btn--soft" href="{{practiceurl}}">{{#str}}practise, mod_aispeakwrite{{/str}}</a>
        </section>
    </div>

    {{#hasresults}}
    <section class="asw-card asw-card--flush">
        <div class="asw-card__head"><h3 class="asw-h2">{{#str}}recentresults, mod_aispeakwrite{{/str}}</h3></div>
        <div class="asw-list">
            {{#results}}
                <a class="asw-list__row" href="{{url}}">
                    <span class="asw-tile {{#speaking}}asw-tile--speaking{{/speaking}}" aria-hidden="true">
                        {{#speaking}}<svg class="asw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>{{/speaking}}
                        {{^speaking}}<svg class="asw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>{{/speaking}}
                    </span>
                    <span style="display: flex; flex-direction: column; flex: 1 1 240px; min-width: 0;">
                        <strong>{{title}}</strong>
                        <span class="asw-sub">{{meta}}</span>
                    </span>
                    <span class="asw-pill asw-pill--{{pillclass}} asw-num">{{score}}</span>
                </a>
            {{/results}}
        </div>
    </section>
    {{/hasresults}}
</div>
