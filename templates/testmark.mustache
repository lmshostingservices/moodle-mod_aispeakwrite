{{!
    @template mod_aispeakwrite/testmark

    Teacher: test the current tips on a sample text.

    Example context (json):
    {
        "title": "Geburtstagsfeier", "actionurl": "#", "sesskey": "x", "sample": "", "think": true, "error": "",
        "backurl": "#"
    }
}}
<div class="asw">
    <div class="asw-row asw-row--between" style="align-items: center;">
        <div>
            <span class="asw-sub">{{#str}}testsample, mod_aispeakwrite{{/str}}</span>
            <h2 class="asw-h2">{{title}}</h2>
        </div>
        <a class="asw-btn asw-btn--soft" href="{{backurl}}">{{#str}}backtotasks, mod_aispeakwrite{{/str}}</a>
    </div>
    <form method="post" action="{{actionurl}}" class="asw-card">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <label for="asw-sample" class="asw-label">{{#str}}sampletext, mod_aispeakwrite{{/str}}</label>
        <textarea id="asw-sample" name="sample" class="asw-notes" style="min-height: 200px;">{{sample}}</textarea>
        <fieldset class="asw-row" style="gap: 16px; border: 0; padding: 0; margin: 0;">
            <legend class="asw-sub" style="font-size: .875rem; float: left; margin: 0 12px 0 0;">{{#str}}mode, mod_aispeakwrite{{/str}}</legend>
            <label class="asw-check"><input type="radio" name="mode" value="think" {{#think}}checked{{/think}}> {{#str}}fbmode_think, mod_aispeakwrite{{/str}}</label>
            <label class="asw-check"><input type="radio" name="mode" value="explain" {{^think}}checked{{/think}}> {{#str}}fbmode_explain, mod_aispeakwrite{{/str}}</label>
        </fieldset>
        {{#error}}<div class="asw-banner asw-banner--bad">{{error}}</div>{{/error}}
        <div class="asw-row" style="align-items: center; gap: 12px;">
            <button type="submit" class="asw-btn asw-btn--ink">{{#str}}runtest, mod_aispeakwrite{{/str}}</button>
            <span class="asw-sub">{{#str}}testcost, mod_aispeakwrite{{/str}}</span>
        </div>
    </form>
</div>
