{{!
    @template mod_aispeakwrite/segments

    One line of the learner's answer: plain text and marks. Kept on one line so no stray spaces appear.

    Example context (json):
    {
        "segments": [
            {"plain": true, "text": "vielen Dank für "},
            {"mark": true, "id": "m0", "n": 1, "kind": "error", "error": true, "text": "den Einladung",
                "showcorrection": true, "correction": "die Einladung"}
        ]
    }
}}
{{#segments}}{{#plain}}{{text}}{{/plain}}{{#mark}}<button type="button" class="asw-mark asw-mark--{{kind}}" data-mark="{{id}}" aria-describedby="asw-note-{{id}}">{{#showcorrection}}<s>{{text}}</s> <ins>{{correction}}</ins>{{/showcorrection}}{{^showcorrection}}{{text}}{{/showcorrection}}{{#error}}<sup class="asw-ref">{{n}}</sup>{{/error}}</button>{{/mark}}{{/segments}}
