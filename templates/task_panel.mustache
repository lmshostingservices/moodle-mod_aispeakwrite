{{!
    @template mod_aispeakwrite/task_panel

    The task: situation, source text and content points.

    Example context (json):
    {
        "hassituation": true,
        "situation": "Sie haben von einem Freund folgende E-Mail erhalten:",
        "hassource": true,
        "sourcetext": "Lieber …,<br>am Samstag werde ich 30!",
        "haspoints": true,
        "points": [{"n": 1, "text": "Ob Sie zur Feier kommen", "min": ""}],
        "targetwords": 150
    }
}}
<section class="asw-card" aria-labelledby="asw-task-h">
    <h3 class="asw-label" id="asw-task-h">{{#str}}task, mod_aispeakwrite{{/str}}</h3>
    <div class="asw-row">
        <div class="asw-main" style="display: flex; flex-direction: column; gap: 12px;">
            {{#hassituation}}<p class="asw-sub" style="font-style: italic;">{{{situation}}}</p>{{/hassituation}}
            {{#hassource}}<div class="asw-task__mail">{{{sourcetext}}}</div>{{/hassource}}
        </div>
        {{#haspoints}}
        <div class="asw-side">
            <span class="asw-label">{{#str}}pointstocover, mod_aispeakwrite{{/str}}</span>
            {{#points}}
                <div class="asw-point">
                    <span class="asw-point__n">{{n}}</span>
                    <span>{{text}} {{#min}}<span class="asw-pill asw-pill--blue">{{min}}</span>{{/min}}</span>
                </div>
            {{/points}}
            {{#targetwords}}<span class="asw-sub">{{#str}}aboutwords, mod_aispeakwrite, {{targetwords}}{{/str}}</span>{{/targetwords}}
        </div>
        {{/haspoints}}
    </div>
</section>
