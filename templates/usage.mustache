{{!
    @template mod_aispeakwrite/usage

    Credit usage cards for teachers.

    Example context (json):
    {
        "hasbalance": true, "balance": "4,820", "lowcredits": false, "usedmonth": 312, "markings": 212, "partnerturns": 90
    }
}}
<section class="asw-card">
    <span class="asw-label">{{#str}}credits, mod_aispeakwrite{{/str}}</span>
    {{#lowcredits}}<div class="asw-banner asw-banner--warn">{{#str}}lowcreditswarning, mod_aispeakwrite{{/str}}</div>{{/lowcredits}}
    <div class="asw-row" style="gap: 12px;">
        <div class="asw-stat"><span class="asw-sub">{{#str}}balance, mod_aispeakwrite{{/str}}</span><strong class="asw-num">{{#hasbalance}}{{balance}}{{/hasbalance}}{{^hasbalance}}–{{/hasbalance}}</strong></div>
        <div class="asw-stat"><span class="asw-sub">{{#str}}usedthismonth, mod_aispeakwrite{{/str}}</span><strong class="asw-num">{{usedmonth}}</strong></div>
        <div class="asw-stat"><span class="asw-sub">{{#str}}markingsthismonth, mod_aispeakwrite{{/str}}</span><strong class="asw-num">{{markings}}</strong></div>
        <div class="asw-stat"><span class="asw-sub">{{#str}}partnerturnsthismonth, mod_aispeakwrite{{/str}}</span><strong class="asw-num">{{partnerturns}}</strong></div>
    </div>
    <span class="asw-sub">{{#str}}creditsexplained, mod_aispeakwrite{{/str}}</span>
</section>
